        // App State
        let currentCategory = 'all';
        let searchQuery = '';
        let favorites = JSON.parse(localStorage.getItem('wild_wiki_favs') || '[]');
        let showOnlyFavorites = false;
        let activeModalAnimal = null;

        // Sound Player simulation using Web Audio API Synthesizer (No external audio asset dependence)
        function playAnimalSound(pitch) {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                const ctx = new AudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(pitch || 300, ctx.currentTime);
                
                // Frequency modulation for natural sound
                osc.frequency.exponentialRampToValueAtTime((pitch || 300) * 0.5, ctx.currentTime + 0.4);

                gain.gain.setValueAtTime(0.3, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);

                osc.connect(gain);
                gain.connect(ctx.destination);

                osc.start();
                osc.stop(ctx.currentTime + 0.5);
            } catch (e) {
                console.log('Audio playback prevented or unsupported');
            }
        }

        // DOM Elements Initial Setup
        document.addEventListener('DOMContentLoaded', () => {
            initTheme();
            renderAnimals();
            updateFavBadge();
        });

        // Dark Mode Logic
        function initTheme() {
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }

        function toggleDarkMode() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        // Render Animal Cards
        function renderAnimals() {
            const grid = document.getElementById('animalGrid');
            const emptyState = document.getElementById('emptyState');
            grid.innerHTML = '';

            const filtered = animalsData.filter(animal => {
                const matchesCategory = currentCategory === 'all' || animal.category === currentCategory;
                const matchesSearch = animal.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                     animal.englishName.toLowerCase().includes(searchQuery.toLowerCase()) ||
                                     animal.habitat.toLowerCase().includes(searchQuery.toLowerCase()) ||
                                     animal.dietType.toLowerCase().includes(searchQuery.toLowerCase());
                const matchesFav = !showOnlyFavorites || favorites.includes(animal.id);

                return matchesCategory && matchesSearch && matchesFav;
            });

            // Handle Empty State
            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }

            // Update Banner Text
            updateFilterBanner();

            // Populate Cards
            filtered.forEach(animal => {
                const isFav = favorites.includes(animal.id);
                const card = document.createElement('div');
                card.className = 'group bg-white dark:bg-zinc-800/90 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-zinc-200/80 dark:border-zinc-700/60 transition-all duration-300 flex flex-col cursor-pointer transform hover:-translate-y-1';
                
                card.innerHTML = `
                    <div class="relative h-48 overflow-hidden bg-zinc-100 dark:bg-zinc-700">
                        <img src="${animal.image}" alt="${animal.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60"></div>
                        
                        <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg text-xs font-semibold bg-black/40 backdrop-blur-md text-white border border-white/20">
                            ${animal.categoryName}
                        </span>

                        <button onclick="event.stopPropagation(); toggleFavorite('${animal.id}')" class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/80 dark:bg-zinc-800/80 backdrop-blur-md flex items-center justify-center text-zinc-600 dark:text-zinc-200 hover:text-red-500 dark:hover:text-red-400 transition-all shadow-md">
                            <i class="${isFav ? 'fa-solid text-red-500' : 'fa-regular'} fa-heart"></i>
                        </button>

                        <div class="absolute bottom-3 left-3 right-3 flex justify-between items-center text-white">
                            <div>
                                <h3 class="text-xl font-bold">${animal.name}</h3>
                                <p class="text-xs text-zinc-200 italic">${animal.englishName}</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
                        <p class="text-zinc-600 dark:text-zinc-300 text-sm line-clamp-2 leading-relaxed">
                            ${animal.summary}
                        </p>

                        <div class="space-y-2 pt-2 border-t border-zinc-100 dark:border-zinc-700/50 text-xs text-zinc-500 dark:text-zinc-400">
                            <div class="flex items-center justify-between">
                                <span class="flex items-center gap-1.5"><i class="fa-solid fa-tree text-emerald-600"></i>棲息地</span>
                                <span class="font-medium text-zinc-700 dark:text-zinc-300 truncate max-w-[140px]">${animal.habitat.split('')[0]}...</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="flex items-center gap-1.5"><i class="fa-solid fa-utensils text-amber-600"></i>食性</span>
                                <span class="font-medium text-zinc-700 dark:text-zinc-300">${animal.dietType}</span>
                            </div>
                        </div>

                        <div class="pt-2 flex items-center justify-between">
                            <span class="text-xs font-semibold px-2 py-0.5 rounded ${animal.statusColor}">${animal.status}</span>
                            <span class="text-xs text-emerald-600 dark:text-emerald-400 font-bold group-hover:translate-x-1 transition-transform flex items-center gap-1">
                                了解更多 <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                `;

                card.addEventListener('click', () => openModal(animal));
                grid.appendChild(card);
            });
        }

        function setCategory(category) {
            currentCategory = category;
            showOnlyFavorites = false;
            
            // Update Tab UI
            document.querySelectorAll('.category-btn').forEach(btn => {
                if (btn.dataset.category === category) {
                    btn.className = 'category-btn active px-4 py-2 rounded-xl font-medium text-sm whitespace-nowrap transition-all bg-emerald-600 text-white shadow-md shadow-emerald-600/20';
                } else {
                    btn.className = 'category-btn px-4 py-2 rounded-xl font-medium text-sm whitespace-nowrap transition-all bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-700';
                }
            });

            renderAnimals();
        }

        function handleSearch() {
            const input = document.getElementById('searchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            searchQuery = input.value.trim();

            if (searchQuery.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }

            renderAnimals();
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('clearSearchBtn').classList.add('hidden');
            searchQuery = '';
            renderAnimals();
        }

        function toggleFavoritesFilter() {
            showOnlyFavorites = !showOnlyFavorites;
            const favBtn = document.getElementById('favoriteToggleBtn');
            
            if (showOnlyFavorites) {
                favBtn.classList.add('bg-red-50', 'dark:bg-red-950/30', 'border-red-300', 'text-red-600');
            } else {
                favBtn.classList.remove('bg-red-50', 'dark:bg-red-950/30', 'border-red-300', 'text-red-600');
            }

            renderAnimals();
        }

        function resetFilters() {
            currentCategory = 'all';
            searchQuery = '';
            showOnlyFavorites = false;
            document.getElementById('searchInput').value = '';
            document.getElementById('clearSearchBtn').classList.add('hidden');
            
            const favBtn = document.getElementById('favoriteToggleBtn');
            favBtn.classList.remove('bg-red-50', 'dark:bg-red-950/30', 'border-red-300', 'text-red-600');

            setCategory('all');
        }

        function updateFilterBanner() {
            const banner = document.getElementById('filterInfoBanner');
            const bannerText = document.getElementById('filterInfoText');

            let parts = [];
            if (showOnlyFavorites) parts.push('我的最愛收藏');
            if (currentCategory !== 'all') {
                const catObj = animalsData.find(a => a.category === currentCategory);
                if (catObj) parts.push(`分類: ${catObj.categoryName}`);
            }
            if (searchQuery) parts.push(`搜尋關鍵字: "${searchQuery}"`);

            if (parts.length > 0) {
                bannerText.textContent = `目前顯示條件：${parts.join(' ｜ ')}`;
                banner.classList.remove('hidden');
            } else {
                banner.classList.add('hidden');
            }
        }

        // Favorites Storage Logic
        function toggleFavorite(id) {
            if (favorites.includes(id)) {
                favorites = favorites.filter(favId => favId !== id);
            } else {
                favorites.push(id);
            }
            localStorage.setItem('wild_wiki_favs', JSON.stringify(favorites));
            updateFavBadge();
            renderAnimals();

            if (activeModalAnimal && activeModalAnimal.id === id) {
                updateModalFavBtnState();
            }
        }

        function updateFavBadge() {
            document.getElementById('favCountBadge').textContent = favorites.length;
        }

        // Modal Window Actions
        function openModal(animal) {
            activeModalAnimal = animal;

            document.getElementById('modalImage').src = animal.image;
            document.getElementById('modalName').textContent = animal.name;
            document.getElementById('modalSciName').textContent = `${animal.englishName} (${animal.sciName})`;
            document.getElementById('modalCategoryTag').textContent = animal.categoryName;
            
            const statusTag = document.getElementById('modalStatusTag');
            statusTag.textContent = animal.status;
            statusTag.className = `px-2.5 py-0.5 rounded-md text-xs font-semibold ${animal.statusColor}`;

            document.getElementById('modalActiveTime').textContent = animal.activeTime;
            document.getElementById('modalDietType').textContent = animal.dietType;
            document.getElementById('modalSocial').textContent = animal.social;

            document.getElementById('modalHabits').textContent = animal.habits;
            document.getElementById('modalHabitat').textContent = animal.habitat;
            document.getElementById('modalDiet').textContent = animal.diet;

            // Render Fun Facts
            const factsList = document.getElementById('modalFunFacts');
            factsList.innerHTML = '';
            animal.funFacts.forEach(fact => {
                const li = document.createElement('li');
                li.textContent = fact;
                factsList.appendChild(li);
            });

            updateModalFavBtnState();

            // Show Modal
            const modal = document.getElementById('detailModal');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // Prevent background scrolling
        }

        function closeModal() {
            const modal = document.getElementById('detailModal');
            modal.classList.add('hidden');
            document.body.style.overflow = '';
            activeModalAnimal = null;
        }

        function toggleModalFavorite() {
            if (activeModalAnimal) {
                toggleFavorite(activeModalAnimal.id);
            }
        }

        function updateModalFavBtnState() {
            if (!activeModalAnimal) return;
            const favBtn = document.getElementById('modalFavBtn');
            const isFav = favorites.includes(activeModalAnimal.id);
            if (isFav) {
                favBtn.innerHTML = '<i class="fa-solid fa-heart text-red-500"></i>';
            } else {
                favBtn.innerHTML = '<i class="fa-regular fa-heart"></i>';
            }
        }

        function playCurrentAnimalSound() {
            if (activeModalAnimal) {
                playAnimalSound(activeModalAnimal.soundPitch);
                
                // Visual feedback on audio button
                const btnText = document.getElementById('modalAudioText');
                const origText = btnText.textContent;
                btnText.textContent = '發聲中...';
                setTimeout(() => {
                    btnText.textContent = origText;
                }, 600);
            }
        }

        // Close modal when clicking dark backdrop
        document.getElementById('detailModal').addEventListener('click', (e) => {
            if (e.target.id === 'detailModal') {
                closeModal();
            }
        });

        // Keyboard accessibility (ESC to close)
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !document.getElementById('detailModal').classList.contains('hidden')) {
                closeModal();
            }
        });
    </script>
